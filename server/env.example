# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ride_together

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT (генерация: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# CORS — домены фронтенда через запятую
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080

# Telegram Bot (для Mini App auth и уведомлений)
TELEGRAM_BOT_TOKEN=

# Email (опционально, для сброса пароля)
EMAIL_FROM=noreply@example.com
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SSL для PostgreSQL (если требуется)
# PGSSLROOTCERT=./ca.crt
