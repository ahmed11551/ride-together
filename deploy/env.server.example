# Скопируйте на сервер: cp deploy/env.server.example server/.env.production
# Заполните все значения перед деплоем

DATABASE_URL=postgresql://user:password@localhost:5432/ride_together

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# openssl rand -base64 32
JWT_SECRET=

# Ваш домен (без слэша в конце)
FRONTEND_URL=https://YOUR_DOMAIN
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

TELEGRAM_BOT_TOKEN=

# Email для сброса пароля (опционально)
EMAIL_FROM=noreply@YOUR_DOMAIN
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SSL для облачной PostgreSQL (Timeweb и т.п.)
# PGSSLROOTCERT=/var/www/ride-together/ca.crt
