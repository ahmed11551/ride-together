# Скопируйте перед сборкой фронта: cp deploy/env.frontend.example .env.production
# Важно: переменные VITE_* вшиваются при npm run build

# Базовый URL сайта (nginx проксирует /api на backend)
VITE_API_URL=https://YOUR_DOMAIN

# Карты (получить: https://developer.tech.yandex.ru/)
VITE_YANDEX_MAPS_API_KEY=

# Опционально
# VITE_WS_URL=wss://YOUR_DOMAIN
# VITE_SENTRY_DSN=
# VITE_GA_MEASUREMENT_ID=
